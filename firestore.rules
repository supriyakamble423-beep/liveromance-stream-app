
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permissive rules for development debugging as requested
    match /hosts/{hostId} {
      allow read, write: if true;
    }
    match /streamMessages/{msgId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /streamRequests/{requestId} {
      allow read, write: if true;
    }
    match /streamSessions/{sessionId} {
      allow read, write: if true;
    }
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
